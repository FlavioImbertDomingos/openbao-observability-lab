      "id": 16,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "1 = site B is connected and streaming. 0 = new OpenBao data exists only in site A.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
