      "id": 15,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "OpenBao keeps a pool per node; after failover the connections move to site B.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 22
